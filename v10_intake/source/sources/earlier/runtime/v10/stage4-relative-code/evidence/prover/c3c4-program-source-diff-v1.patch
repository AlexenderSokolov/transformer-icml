+def parameters(N, bits, d):
+    assert N >= 6 and bits >= 1 and d >= 6
+    m = N//2
+    h = clog2(256*(N-2))
+    p = 4*h+4*clog2(m+4)+64
+    return dict(N=N, b=bits, d=d, n=N+1, m=m, M=m-2, h=h, A=1<<h,
+                p=p, R=1<<p, ell=clog2(N+2), tau=(d+1).bit_length())
+
